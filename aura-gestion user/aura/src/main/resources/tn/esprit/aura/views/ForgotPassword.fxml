<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="800" prefWidth="1280" styleClass="root-pane" stylesheets="@../styles/style.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/20.0.1" fx:controller="tn.esprit.aura.controllers.ForgotPasswordController">

    <VBox alignment="CENTER" spacing="0" styleClass="auth-bg">

        <!-- Retour to login -->
        <HBox alignment="TOP_LEFT">
            <padding><Insets left="30" top="20" /></padding>
            <Button onAction="#handleBackToLogin" styleClass="nav-link" text="← Retour a la connexion" />
        </HBox>

        <VBox alignment="CENTER" VBox.vgrow="ALWAYS">
            <!-- Forgot Mot de passe Card -->
            <VBox alignment="CENTER" maxHeight="450" maxWidth="420" spacing="22" styleClass="glass-card">
                <padding><Insets bottom="40" left="40" right="40" top="40" /></padding>

                <!-- Logo -->
                <HBox alignment="CENTER" spacing="8">
                    <Label styleClass="logo-icon" text="△" />
                    <Label styleClass="logo-text" text="AURA" />
                </HBox>

                <Label fx:id="cardTitle" styleClass="card-title" text="Reinitialiser le mot de passe" />
                
                <!-- Erreur/Succes Label -->
                <Label fx:id="messageLabel" styleClass="error-label" text="" wrapText="true" alignment="CENTER" />

                <!-- Step 1: Email Input -->
                <VBox fx:id="step1Email" spacing="22" alignment="CENTER">
                    <Label styleClass="card-subtitle" text="Entrez votre email pour recevoir un code" wrapText="true" alignment="CENTER" />
                    
                    <VBox spacing="8" alignment="CENTER_LEFT">
                        <Label styleClass="field-label" text="Adresse email" />
                        <TextField fx:id="emailField" promptText="you@example.com" styleClass="text-input" maxWidth="Infinity" />
                    </VBox>

                    <Button maxWidth="Infinity" onAction="#handleSendCode" styleClass="btn-primary-full" text="Envoyer le code" />
                </VBox>

                <!-- Step 2: OTP Input -->
                <VBox fx:id="step2OTP" spacing="22" alignment="CENTER" visible="false" managed="false">
                    <Label styleClass="card-subtitle" text="Nous avons envoye un code a 6 chiffres a votre email." wrapText="true" alignment="CENTER" />
                    
                    <VBox spacing="8" alignment="CENTER_LEFT">
                        <Label styleClass="field-label" text="Code de verification" />
                        <TextField fx:id="otpField" promptText="000000" styleClass="text-input" alignment="CENTER" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-letter-spacing: 4px;" />
                    </VBox>

                    <Button maxWidth="Infinity" onAction="#handleVerifyOTP" styleClass="btn-primary-full" text="Verifier le code" />
                    <Hyperlink onAction="#handleResendOTP" styleClass="link-text" text="Renvoyer le code" />
                </VBox>

                <!-- Step 3: Nouveau mot de passe -->
                <VBox fx:id="step3Password" spacing="22" alignment="CENTER" visible="false" managed="false">
                    <Label styleClass="card-subtitle" text="Choisissez un nouveau mot de passe securise" wrapText="true" alignment="CENTER" />
                    
                    <VBox spacing="8" alignment="CENTER_LEFT">
                        <Label styleClass="field-label" text="Nouveau mot de passe" />
                        <PasswordField fx:id="newPasswordField" promptText="••••••••" styleClass="text-input" />
                    </VBox>

                    <VBox spacing="8" alignment="CENTER_LEFT">
                        <Label styleClass="field-label" text="Confirmer le mot de passe" />
                        <PasswordField fx:id="confirmPasswordField" promptText="••••••••" styleClass="text-input" />
                    </VBox>

                    <Button maxWidth="Infinity" onAction="#handleResetPassword" styleClass="btn-primary-full" text="Mettre a jour le mot de passe" />
                </VBox>

                <!-- Retour a la connexion Link -->
                <HBox alignment="CENTER" spacing="5">
                    <Hyperlink onAction="#handleBackToLogin" styleClass="link-teal" text="Retour a la connexion" />
                </HBox>
            </VBox>
        </VBox>
    </VBox>
</StackPane>
