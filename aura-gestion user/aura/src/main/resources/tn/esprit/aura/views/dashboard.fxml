<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>


<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.esprit.aura.controllers.DashboardController"
      style="-fx-background-color: #0A0C0F;"
      prefWidth="1280" prefHeight="780">

    <!-- NAVBAR -->
    <HBox style="-fx-background-color: #0A0C0F; -fx-border-color: rgba(27,191,168,0.2); -fx-border-width: 0 0 1 0; -fx-padding: 16 24 16 24;" alignment="CENTER_LEFT">
        <Label text="AURA" style="-fx-text-fill: #1BBFA8; -fx-font-size: 24; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="AI LIFE COMPANION" style="-fx-text-fill: #A8B4C0; -fx-font-size: 11;"/>
    </HBox>

    <!-- MAIN CONTENT -->
    <HBox VBox.vgrow="ALWAYS">

        <!-- COLONNE GAUCHE -->
        <VBox prefWidth="300" spacing="16" style="-fx-padding: 24; -fx-background-color: #0A0C0F;">

            <!-- Carte profil -->
            <VBox alignment="CENTER" spacing="12"
                  style="-fx-background-color: #111418; -fx-background-radius: 16; -fx-border-color: rgba(27,191,168,0.15); -fx-border-radius: 16; -fx-border-width: 1; -fx-padding: 24;">
                <Circle radius="40" fill="transparent" stroke="#1BBFA8" strokeWidth="2"/>
                <Label fx:id="userName" text="Ines" style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;"/>
                <Label text="ACTIVE" style="-fx-background-color: rgba(27,191,168,0.15); -fx-text-fill: #1BBFA8; -fx-background-radius: 20; -fx-padding: 4 12 4 12; -fx-font-size: 11; -fx-font-weight: bold;"/>
            </VBox>

            <!-- Ajouter une tâche -->
            <VBox spacing="10"
                  style="-fx-background-color: #111418; -fx-background-radius: 16; -fx-border-color: rgba(27,191,168,0.15); -fx-border-radius: 16; -fx-border-width: 1; -fx-padding: 20;">
                <Label text="➕ Ajouter une tâche" style="-fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold;"/>
                <TextField fx:id="taskTitleField" promptText="Titre de la tâche..."
                           style="-fx-background-color: #1E2329; -fx-text-fill: white; -fx-prompt-text-fill: #A8B4C0; -fx-background-radius: 8; -fx-padding: 10; -fx-border-width: 0;"/>
                <ComboBox fx:id="taskPriorityBox" promptText="Priorité"
                          style="-fx-background-color: #1E2329; -fx-text-fill: white; -fx-background-radius: 8;"
                          maxWidth="Infinity"/>
                <TextField fx:id="taskDateField" promptText="Date (2025-06-01)"
                           style="-fx-background-color: #1E2329; -fx-text-fill: white; -fx-prompt-text-fill: #A8B4C0; -fx-background-radius: 8; -fx-padding: 10; -fx-border-width: 0;"/>
                <Button text="Ajouter" onAction="#onAddTask" maxWidth="Infinity"
                        style="-fx-background-color: #1BBFA8; -fx-text-fill: black; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10; -fx-cursor: hand;"/>
            </VBox>

            <!-- Transcription -->
            <VBox spacing="8"
                  style="-fx-background-color: #111418; -fx-background-radius: 16; -fx-border-color: rgba(27,191,168,0.15); -fx-border-radius: 16; -fx-border-width: 1; -fx-padding: 20;">
                <Label text="📝 Tu as dit..." style="-fx-text-fill: #A8B4C0; -fx-font-size: 12;"/>
                <Label fx:id="transcriptionLabel" text="—"
                       wrapText="true"
                       style="-fx-text-fill: white; -fx-font-size: 13; -fx-font-style: italic;"/>
            </VBox>
        </VBox>

        <!-- COLONNE CENTRALE -->
        <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="20"
              style="-fx-padding: 24; -fx-background-color: #0A0C0F;">

            <!-- Badges énergie + focus -->
            <HBox spacing="12" alignment="CENTER">
                <Label fx:id="energyBadge" text="ENERGY: — "
                       style="-fx-background-color: #1E2329; -fx-text-fill: #A8B4C0; -fx-background-radius: 20; -fx-padding: 6 16 6 16; -fx-font-size: 12; -fx-border-color: rgba(255,255,255,0.08); -fx-border-radius: 20; -fx-border-width: 1;"/>
                <Label fx:id="focusBadge" text="HUMEUR: —"
                       style="-fx-background-color: #1E2329; -fx-text-fill: #A8B4C0; -fx-background-radius: 20; -fx-padding: 6 16 6 16; -fx-font-size: 12; -fx-border-color: rgba(255,255,255,0.08); -fx-border-radius: 20; -fx-border-width: 1;"/>
            </HBox>

            <!-- ORB -->
            <StackPane>
                <Circle radius="200" fill="transparent" stroke="#1BBFA8" strokeWidth="1" opacity="0.08"/>
                <Circle radius="170" fill="#0A0C0F" opacity="0.5" stroke="#1BBFA8" strokeWidth="1"/>
                <Circle fx:id="orbCircle" radius="140" fill="#6B5FD4"/>
                <VBox alignment="CENTER" spacing="4">
                    <Label fx:id="orbText1" text="Comment tu te sens ?"
                           style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;"/>
                    <Label fx:id="orbText2" text="Clique sur le micro 🎤"
                           style="-fx-text-fill: white; -fx-font-size: 14;"/>
                </VBox>
            </StackPane>

            <!-- Bouton micro -->
            <Button fx:id="micButton" text="🎤"
                    onAction="#onMicClick"
                    style="-fx-background-color: #1E2329; -fx-text-fill: white; -fx-background-radius: 30; -fx-padding: 14 20 14 20; -fx-font-size: 18; -fx-border-color: rgba(27,191,168,0.3); -fx-border-radius: 30; -fx-border-width: 1; -fx-cursor: hand;"/>

            <!-- Status -->
            <Label fx:id="statusLabel" text=""
                   style="-fx-text-fill: #1BBFA8; -fx-font-size: 13;"/>
        </VBox>

        <!-- COLONNE DROITE -->
        <VBox prefWidth="340" spacing="16"
              style="-fx-padding: 24; -fx-background-color: #0A0C0F;">

            <!-- Planning -->
            <VBox spacing="12" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: #111418; -fx-background-radius: 16; -fx-border-color: rgba(27,191,168,0.15); -fx-border-radius: 16; -fx-border-width: 1; -fx-padding: 20;">
                <Label text="📅 Adaptive Schedule" style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;"/>
                <Label fx:id="planningSubtitle" text="Parle pour adapter ton planning"
                       style="-fx-text-fill: #A8B4C0; -fx-font-size: 12;"/>
                <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                    <VBox fx:id="taskList" spacing="10"/>
                </ScrollPane>
            </VBox>

            <!-- Focus Timer -->
            <VBox alignment="CENTER" spacing="12"
                  style="-fx-background-color: #111418; -fx-background-radius: 16; -fx-border-color: rgba(27,191,168,0.15); -fx-border-radius: 16; -fx-border-width: 1; -fx-padding: 20;">
                <Label text="⏱ Focus Mode" style="-fx-text-fill: #A8B4C0; -fx-font-size: 13;"/>
                <Label fx:id="timerLabel" text="25:00"
                       style="-fx-text-fill: white; -fx-font-size: 42; -fx-font-weight: bold;"/>
                <HBox spacing="10" alignment="CENTER">
                    <Button text="START" onAction="#onStartTimer"
                            style="-fx-background-color: #6B5FD4; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 8 20 8 20; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    <Button text="RESET" onAction="#onResetTimer"
                            style="-fx-background-color: #1E2329; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 8 20 8 20; -fx-cursor: hand;"/>
                </HBox>
            </VBox>
        </VBox>
    </HBox>
</VBox>