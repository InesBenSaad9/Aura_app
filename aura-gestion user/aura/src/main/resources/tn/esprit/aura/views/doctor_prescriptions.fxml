<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.aura.controllers.doctor.DoctorPrescriptionsView"
            style="-fx-background-color: #0d1117;">

    <top>
        <VBox style="-fx-padding: 32 32 20 32; -fx-background-color: #0d1117;" spacing="6">
            <Label text="Prescriptions"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Gérez les prescriptions de vos patients"
                   style="-fx-font-size: 13px; -fx-text-fill: #6e7681;"/>
        </VBox>
    </top>

    <center>
        <HBox style="-fx-padding: 0 32 32 32;" spacing="24">

            <!-- Create Prescription Form -->
            <VBox spacing="16" prefWidth="340"
                  style="-fx-background-color: #161b22; -fx-background-radius: 12;
                         -fx-padding: 24; -fx-border-color: #30363d;
                         -fx-border-width: 1; -fx-border-radius: 12;">

                <Label fx:id="formTitle" text="Nouvelle prescription"
                       style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Separator style="-fx-background-color: #21262d;"/>

                <VBox spacing="5">
                    <Label text="Patient :" style="-fx-text-fill: #8b949e; -fx-font-size: 12px;"/>
                    <ComboBox fx:id="patientCombo" promptText="Sélectionner un patient"
                              maxWidth="Infinity"
                              style="-fx-background-color: #0d1117; -fx-text-fill: white;
                                     -fx-border-color: #30363d; -fx-border-radius: 8;
                                     -fx-background-radius: 8;"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Médicament :" style="-fx-text-fill: #8b949e; -fx-font-size: 12px;"/>
                    <TextField fx:id="medicamentField" promptText="Nom du médicament"
                               style="-fx-background-color: #0d1117; -fx-text-fill: white;
                                      -fx-prompt-text-fill: #484f58; -fx-border-color: #30363d;
                                      -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14;"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Dosage :" style="-fx-text-fill: #8b949e; -fx-font-size: 12px;"/>
                    <TextField fx:id="dosageField" promptText="Ex: 500mg — 2x par jour"
                               style="-fx-background-color: #0d1117; -fx-text-fill: white;
                                      -fx-prompt-text-fill: #484f58; -fx-border-color: #30363d;
                                      -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14;"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Instructions :" style="-fx-text-fill: #8b949e; -fx-font-size: 12px;"/>
                    <TextArea fx:id="instructionsField" promptText="Instructions supplémentaires..."
                              prefHeight="90" wrapText="true"
                              style="-fx-background-color: #0d1117; -fx-text-fill: white;
                                     -fx-prompt-text-fill: #484f58; -fx-border-color: #30363d;
                                     -fx-border-radius: 8; -fx-background-radius: 8;"/>
                </VBox>

                <Label fx:id="statusLabel" text=""
                       style="-fx-font-size: 12px;" wrapText="true"/>

                <Button fx:id="saveBtn" text="Sauvegarder" onAction="#savePrescription"
                        maxWidth="Infinity"
                        style="-fx-background-color: #00b4ab; -fx-text-fill: white; -fx-font-weight: bold;
                               -fx-background-radius: 8; -fx-padding: 11; -fx-cursor: hand; -fx-font-size: 13px;"/>
                <Button fx:id="cancelEditBtn" text="Annuler la modification" onAction="#cancelEdit"
                        visible="false" managed="false" maxWidth="Infinity"
                        style="-fx-background-color: #30363d; -fx-text-fill: white; -fx-font-weight: bold;
                               -fx-background-radius: 8; -fx-padding: 10; -fx-cursor: hand; -fx-font-size: 13px;"/>
            </VBox>

            <!-- Prescriptions list -->
            <VBox HBox.hgrow="ALWAYS" spacing="12">
                <Label text="Prescriptions émises"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                    <VBox fx:id="prescriptionsContainer" spacing="10"/>
                </ScrollPane>
            </VBox>

        </HBox>
    </center>
</BorderPane>
