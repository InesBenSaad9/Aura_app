<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<StackPane prefHeight="500" prefWidth="500" styleClass="glass-card" stylesheets="@../styles/style.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/20.0.1" fx:controller="tn.esprit.aura.controllers.FaceIdRegisterController">

    <VBox alignment="CENTER" spacing="20">
        <padding><Insets bottom="30" left="30" right="30" top="30" /></padding>

        <Label styleClass="card-title" text="Enregistrement Face ID" />
        <Label styleClass="card-subtitle" text="Placez votre visage pour enregistrer votre identite biometrique" />

        <StackPane style="-fx-background-color: #000; -fx-background-radius: 12; -fx-overflow: hidden;">
            <ImageView fx:id="webcamView" fitHeight="300" fitWidth="400" preserveRatio="true" />
            <VBox alignment="CENTER" style="-fx-border-color: #1BBFA8; -fx-border-width: 2; -fx-border-radius: 150; -fx-max-width: 220; -fx-max-height: 220;" />
            <ProgressIndicator fx:id="loadingIndicator" visible="false" />
        </StackPane>

        <Label fx:id="statusLabel" styleClass="card-subtitle" text="Initialisation de la camera..." />

        <HBox alignment="CENTER" spacing="15">
            <Button fx:id="btnCapture" onAction="#handleRegister" styleClass="btn-primary" text="Enregistrer mon visage" disable="true" />
            <Button onAction="#handleCancel" styleClass="btn-ghost" text="Annuler" />
        </HBox>
    </VBox>

</StackPane>
