<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:id="rootHBox"
      fx:controller="View.MainController"
      style="-fx-background-color: #0A0C0F;"
      prefWidth="1280" prefHeight="800">

    <!-- SIDEBAR -->
    <VBox fx:id="sidebar" prefWidth="200" minWidth="200"
          style="-fx-background-color: #111418; -fx-border-width: 0;">

        <!-- Logo -->
        <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 28 16;">
            <Circle radius="20" fill="#1BBFA8"/>
            <VBox spacing="2">
                <Label text="AURA" style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;"/>
                <Label text="AI Life Companion" style="-fx-text-fill: #A8B4C0; -fx-font-size: 10;"/>
            </VBox>
        </HBox>

        <!-- User card -->
        <HBox spacing="10" alignment="CENTER_LEFT"
              style="-fx-padding: 16; -fx-background-color: rgba(27,191,168,0.05);">
            <Circle radius="20" fill="#1BBFA8"/>
            <VBox spacing="2">
                <Label fx:id="sidebarUserName" text="Ines"
                       style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;"/>
                <Label text="ACTIVE"
                       style="-fx-text-fill: #1BBFA8; -fx-font-size: 10; -fx-font-weight: bold;"/>
            </VBox>
        </HBox>

        <Region prefHeight="16"/>

        <!-- Navigation -->
        <VBox spacing="4" style="-fx-padding: 0 8;" VBox.vgrow="ALWAYS">
            <Button fx:id="btnTasks"      text="Taches"       maxWidth="Infinity" onAction="#showTasks"
                    style="-fx-background-color: transparent; -fx-text-fill: #A8B4C0; -fx-font-size: 14; -fx-alignment: CENTER_LEFT; -fx-padding: 12 16; -fx-background-radius: 10; -fx-cursor: hand;"/>
            <Button fx:id="btnAI"         text="AI Analysis" maxWidth="Infinity" onAction="#showAIAnalysis"
                    style="-fx-background-color: transparent; -fx-text-fill: #A8B4C0; -fx-font-size: 14; -fx-alignment: CENTER_LEFT; -fx-padding: 12 16; -fx-background-radius: 10; -fx-cursor: hand;"/>
            <Button fx:id="btnActivities" text="Activities"  maxWidth="Infinity" onAction="#showActivities"
                    style="-fx-background-color: transparent; -fx-text-fill: #A8B4C0; -fx-font-size: 14; -fx-alignment: CENTER_LEFT; -fx-padding: 12 16; -fx-background-radius: 10; -fx-cursor: hand;"/>
            <Button fx:id="btnMedical"    text="Medical"     maxWidth="Infinity" onAction="#showMedical"
                    style="-fx-background-color: transparent; -fx-text-fill: #A8B4C0; -fx-font-size: 14; -fx-alignment: CENTER_LEFT; -fx-padding: 12 16; -fx-background-radius: 10; -fx-cursor: hand;"/>
            <Button fx:id="btnMessages"   text="Messages"    maxWidth="Infinity" onAction="#showMessages"
                    style="-fx-background-color: transparent; -fx-text-fill: #A8B4C0; -fx-font-size: 14; -fx-alignment: CENTER_LEFT; -fx-padding: 12 16; -fx-background-radius: 10; -fx-cursor: hand;"/>
            <Button fx:id="btnEvents"     text="Evenement"      maxWidth="Infinity" onAction="#showEvents"
                    style="-fx-background-color: transparent; -fx-text-fill: #A8B4C0; -fx-font-size: 14; -fx-alignment: CENTER_LEFT; -fx-padding: 12 16; -fx-background-radius: 10; -fx-cursor: hand;"/>
            <Button fx:id="btnProfile"    text="Profile"     maxWidth="Infinity" onAction="#showProfile"
                    style="-fx-background-color: transparent; -fx-text-fill: #A8B4C0; -fx-font-size: 14; -fx-alignment: CENTER_LEFT; -fx-padding: 12 16; -fx-background-radius: 10; -fx-cursor: hand;"/>
        </VBox>

        <!-- Bottom -->
        <VBox spacing="4" style="-fx-padding: 8;">
            <Button fx:id="btnLightMode" text="☀ Light Mode" maxWidth="Infinity"
                    onAction="#onLightMode"
                    style="-fx-background-color: transparent; -fx-text-fill: #A8B4C0; -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 10 16; -fx-background-radius: 10; -fx-cursor: hand;"/>
            <Button text="⚙ Paramétres" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #A8B4C0; -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 10 16; -fx-background-radius: 10; -fx-cursor: hand;"/>
            <Button text="Déconnecter" maxWidth="Infinity" onAction="#onLogout"
                    style="-fx-background-color: transparent; -fx-text-fill: #E85D3A; -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 10 16; -fx-background-radius: 10; -fx-cursor: hand;"/>
        </VBox>
    </VBox>

    <!-- CONTENT — transparent pour hériter du fond rootHBox -->
    <StackPane fx:id="contentArea" HBox.hgrow="ALWAYS"
               style="-fx-background-color: transparent;"/>

</HBox>
