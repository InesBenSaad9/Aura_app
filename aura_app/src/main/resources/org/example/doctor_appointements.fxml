<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.ui.views.doctor.DoctorAppointmentsView"
            style="-fx-background-color: #0d1117;">

    <top>
        <VBox style="-fx-padding: 32 32 20 32; -fx-background-color: #0d1117;" spacing="6">
            <Label text="Mes Rendez-vous"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Agenda et gestion de vos consultations"
                   style="-fx-font-size: 13px; -fx-text-fill: #6e7681;"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: #0d1117; -fx-background: #0d1117;">
            <VBox style="-fx-padding: 0 32 32 32;" spacing="12">

                <!-- Stats row -->
                <HBox spacing="16" style="-fx-padding: 0 0 8 0;">
                    <VBox HBox.hgrow="ALWAYS" spacing="6" alignment="CENTER"
                          style="-fx-background-color: #161b22; -fx-background-radius: 12;
                                 -fx-padding: 20; -fx-border-color: #30363d;
                                 -fx-border-width: 1; -fx-border-radius: 12;">
                        <Label fx:id="totalLabel" text="0"
                               style="-fx-text-fill: #00b4ab; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                        <Label text="Total RDV" style="-fx-text-fill: #8b949e; -fx-font-size: 12px;"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="6" alignment="CENTER"
                          style="-fx-background-color: #161b22; -fx-background-radius: 12;
                                 -fx-padding: 20; -fx-border-color: #30363d;
                                 -fx-border-width: 1; -fx-border-radius: 12;">
                        <Label fx:id="pendingLabel" text="0"
                               style="-fx-text-fill: #f0a500; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                        <Label text="En attente" style="-fx-text-fill: #8b949e; -fx-font-size: 12px;"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="6" alignment="CENTER"
                          style="-fx-background-color: #161b22; -fx-background-radius: 12;
                                 -fx-padding: 20; -fx-border-color: #30363d;
                                 -fx-border-width: 1; -fx-border-radius: 12;">
                        <Label fx:id="confirmedLabel" text="0"
                               style="-fx-text-fill: #00b4ab; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                        <Label text="Confirmés" style="-fx-text-fill: #8b949e; -fx-font-size: 12px;"/>
                    </VBox>
                </HBox>

                <!-- Appointments list -->
                <VBox spacing="12">
                    <Label text="Liste des rendez-vous"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <VBox fx:id="appointmentsContainer" spacing="10"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
