<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="org.example.ui.views.RegisterView"
           style="-fx-background-color: #0d1117;">

    <VBox alignment="CENTER" spacing="0" maxWidth="420">
        <VBox alignment="CENTER" spacing="8" style="-fx-padding: 0 0 24 0;">
            <Label text="🧠" style="-fx-font-size: 40px;"/>
            <Label text="AURA" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Créer un compte" style="-fx-font-size: 13px; -fx-text-fill: #6e7681;"/>
        </VBox>

        <VBox spacing="14" style="-fx-background-color: #161b22; -fx-background-radius: 16; -fx-padding: 28; -fx-border-color: #30363d; -fx-border-radius: 16; -fx-border-width: 1;">
            <Label text="Inscription" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>

            <VBox spacing="5">
                <Label text="Nom d'utilisateur" style="-fx-text-fill: #8b949e; -fx-font-size: 12px;"/>
                <TextField fx:id="usernameField" promptText="Username"
                           style="-fx-background-color: #0d1117; -fx-text-fill: white; -fx-prompt-text-fill: #484f58; -fx-border-color: #30363d; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14;"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Email" style="-fx-text-fill: #8b949e; -fx-font-size: 12px;"/>
                <TextField fx:id="emailField" promptText="votre@email.com"
                           style="-fx-background-color: #0d1117; -fx-text-fill: white; -fx-prompt-text-fill: #484f58; -fx-border-color: #30363d; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14;"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Mot de passe" style="-fx-text-fill: #8b949e; -fx-font-size: 12px;"/>
                <PasswordField fx:id="passwordField" promptText="Mot de passe"
                               style="-fx-background-color: #0d1117; -fx-text-fill: white; -fx-prompt-text-fill: #484f58; -fx-border-color: #30363d; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14;"/>
            </VBox>

            <Label fx:id="errorLabel" text="" style="-fx-text-fill: #f85149; -fx-font-size: 12px;" wrapText="true"/>

            <Button text="S'inscrire" onAction="#handleRegister" maxWidth="Infinity"
                    style="-fx-background-color: #00b4ab; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 11; -fx-cursor: hand;"/>

            <HBox alignment="CENTER" spacing="6">
                <Label text="Déjà un compte ?" style="-fx-text-fill: #6e7681; -fx-font-size: 12px;"/>
                <Hyperlink text="Se connecter" onAction="#backToLogin"
                           style="-fx-text-fill: #00b4ab; -fx-font-size: 12px; -fx-border-color: transparent;"/>
            </HBox>
        </VBox>
    </VBox>
</StackPane>
