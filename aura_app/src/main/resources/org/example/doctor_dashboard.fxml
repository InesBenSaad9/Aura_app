<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.ui.views.doctor.DoctorDashboard"
            style="-fx-background-color: #0d1117;">

    <left>
        <VBox prefWidth="220" maxWidth="220" style="-fx-background-color: #0b0f14; -fx-border-color: #12352f; -fx-border-width: 0 1 0 0;">
            <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 28 16 24 16;">
                <Label text=""
                       style="-fx-background-color: #24c3b2; -fx-min-width: 46; -fx-min-height: 46; -fx-background-radius: 23;"/>
                <VBox spacing="5">
                    <Label text="AURA" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="AI Life Companion" style="-fx-font-size: 12px; -fx-text-fill: #c9d7e8;"/>
                </VBox>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="12"
                  style="-fx-padding: 18 16; -fx-background-color: #0d1d20;">
                <Label fx:id="doctorAvatarLabel"
                       style="-fx-background-color: #24c3b2; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 17px; -fx-min-width: 46; -fx-min-height: 46; -fx-background-radius: 23; -fx-alignment: center;"/>
                <VBox spacing="5">
                    <Label fx:id="doctorNameLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="ACTIVE" style="-fx-text-fill: #24e0ce; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>

            <VBox spacing="12" style="-fx-padding: 22 10;">
                <Button fx:id="btnDemandes" text="Demandes" onAction="#showDemandes"
                        maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: #123a37; -fx-text-fill: #24e0ce; -fx-font-size: 16px; -fx-padding: 12 18; -fx-background-radius: 0 14 14 0; -fx-border-color: #24e0ce; -fx-border-width: 0 0 0 4; -fx-cursor: hand;"/>
                <Button fx:id="btnPatients" text="Patients" onAction="#showPatients"
                        maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #d7e5f7; -fx-font-size: 16px; -fx-padding: 11 20; -fx-background-radius: 0 14 14 0; -fx-border-color: transparent; -fx-border-width: 0 0 0 4; -fx-cursor: hand;"/>
                <Button fx:id="btnPrescriptions" text="Prescriptions" onAction="#showPrescriptions"
                        maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #d7e5f7; -fx-font-size: 16px; -fx-padding: 11 20; -fx-background-radius: 0 14 14 0; -fx-border-color: transparent; -fx-border-width: 0 0 0 4; -fx-cursor: hand;"/>
                <Button fx:id="btnMessages" text="Messages" onAction="#showMessages"
                        maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #d7e5f7; -fx-font-size: 16px; -fx-padding: 11 20; -fx-background-radius: 0 14 14 0; -fx-border-color: transparent; -fx-border-width: 0 0 0 4; -fx-cursor: hand;"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="10" style="-fx-padding: 0 22 22 22;">
                <Button text="Light Mode" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #d7e5f7; -fx-font-size: 15px; -fx-padding: 8 4; -fx-cursor: hand;"/>
                <Button text="Settings" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #d7e5f7; -fx-font-size: 15px; -fx-padding: 8 4; -fx-cursor: hand;"/>
                <Button text="Logout" onAction="#handleLogout"
                        style="-fx-background-color: transparent; -fx-text-fill: #ff6848; -fx-font-size: 15px; -fx-padding: 8 4; -fx-cursor: hand;"
                        maxWidth="Infinity" alignment="CENTER_LEFT"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #0d1117; -fx-background: #0d1117;">
            <VBox style="-fx-padding: 32;" spacing="24">
                <Label fx:id="welcomeLabel"
                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <VBox spacing="16">
                    <Label text="Demandes de Seance"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <VBox fx:id="requestsContainer" spacing="10"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
